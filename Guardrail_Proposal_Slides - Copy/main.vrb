\frametitle{Training Data \& Data Loading Pipeline}

	\begin{columns}[t]
		\column{0.38\textwidth}
		\textbf{\textcolor{red}{Adversarial (label=1)}}
		\vspace{0.3em}
		
		\begin{tabular}{lc}
			\toprule
			\textbf{Source} & \textbf{n} \\
			\midrule
			rubend18 GPT-4 JB    & 79  \\
			JailbreakBench       & 100 \\
			HarmBench            & 400 \\
			AdvBench             & 520 \\
			\midrule
			\textbf{Total}       & \textbf{1{,}099} \\
			\bottomrule
		\end{tabular}
		
		\vspace{0.5em}
		\textbf{\textcolor{blue}{Benign (label=0)}}
		\vspace{0.3em}
		
		\begin{tabular}{lc}
			\toprule
			\textbf{Source} & \textbf{n} \\
			\midrule
			BoolQ (SuperGLUE)    & 3{,}270 \\
			OpenOrca             & 5{,}000 \\
			\midrule
			\textbf{Total}       & \textbf{8{,}270} \\
			\bottomrule
		\end{tabular}
		
		\column{0.58\textwidth}
		\textbf{Loading pipeline (\texttt{data\_loading.py})}
		\vspace{0.3em}
		
		\begin{enumerate}\itemsep2pt
			\item \textbf{Load} each source via HuggingFace \texttt{datasets}
			or direct HTTP into a \texttt{Source} dataclass
			\item \textbf{Deduplicate} globally on lowercased text
			(9{,}369 $\rightarrow$ 9{,}220 records)
			\item \textbf{Stratified 80/20 split} (seed=42) preserving
			class ratio $\rightarrow$ train: 7{,}376 / test: 1{,}844
			\item \textbf{Write} \texttt{train.jsonl}, \texttt{test.jsonl},
			\texttt{stats.json} \\
			Format: \texttt{\{"text":..., "label":0|1, "source":...\}}
		\end{enumerate}
		
		\vspace{0.4em}
		\begin{block}{Notes}
			\small
			OpenOrca is 4M+ rows (streaming) --- capped at 5{,}000. \\
			CLI: \texttt{--max-per-source N}, \texttt{--out-dir DIR}.
		\end{block}
	\end{columns}
	
